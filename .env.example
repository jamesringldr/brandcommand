# Copy to .env.local and fill in from the Supabase project settings.
# Service-role key NEVER goes here — it belongs in bws for serv02 / Edge Functions.

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# true = skip Google login + use demo brands (local UI work)
VITE_SKIP_AUTH=true
